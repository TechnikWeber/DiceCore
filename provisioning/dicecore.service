[Unit]
Description=DiceCore — reads real dice with a camera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root, deliberately. Two things need it and both are the difference between a box you can
# recover and one you cannot: managing WiFi through NetworkManager when the network is gone,
# and binding port 80 for the captive portal that opens the setup page on a phone. The
# alternative is a box on a shelf with no keyboard, no screen and no way in.
User=root
# The camera lives behind /dev/video* and /dev/dma_heap, hence the video group.
WorkingDirectory=/opt/dicecore
Environment=DICECORE_STATE=/var/lib/dicecore
ExecStart=/opt/dicecore/.venv/bin/dicecore serve
Restart=always
RestartSec=3

# A headless box must stay reachable to be fixed, so the service is deliberately allowed to
# come up even when the camera does not: DiceCore reports capture failures through its own
# UI rather than exiting.
StandardOutput=journal
StandardError=journal

# config.txt stays writable because the CSI module panel writes it — the one file that
# decides whether the Pi boots. Backed up beside itself on every change; see boot_config.py.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
